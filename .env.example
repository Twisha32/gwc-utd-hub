# Optional. docker compose works without a .env, these just override the defaults.
POSTGRES_PASSWORD=gwc
JWT_SECRET=pick-a-long-random-string
FLAG_PEPPER=pick-another-one

# Comma separated. Empty means anyone can sign up.
ALLOWED_EMAIL_DOMAINS=utdallas.edu

# These emails become officers when they register.
OFFICER_EMAILS=

# If set, people need this code to sign up.
CLUB_JOIN_CODE=
