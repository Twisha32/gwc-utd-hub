# copy to .env for local dev
PORT=4000
DATABASE_URL=postgres://gwc:gwc@localhost:5432/gwc
JWT_SECRET=change-me-to-something-long-and-random
FLAG_PEPPER=change-me-too

# where the web app lives (used for CORS and the origin check on writes)
WEB_ORIGIN=http://localhost:3000

# only these email domains can sign up. leave empty to allow anyone
ALLOWED_EMAIL_DOMAINS=utdallas.edu

# these emails become officers when they register (comma separated)
OFFICER_EMAILS=

# optional: people need this code to sign up. share it at meetings / in discord
CLUB_JOIN_CODE=
